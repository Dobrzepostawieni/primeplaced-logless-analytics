{
	"name": "dobrzepostawieni/primeplaced-logless-analytics",
	"description": "Privacy-first, cookieless WordPress analytics with local storage, data minimization, and explicit retention controls",
	"homepage": "https://dobrzepostawieni.pl",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Dobrzepostawieni",
			"email": "contact@dobrzepostawieni.pl",
			"homepage": "https://dobrzepostawieni.pl"
		}
	],
	"require": {
		"php": ">=7.4",
		"freemius/wordpress-sdk": "^2.13",
		"inpsyde/assets": "^2.13",
		"inpsyde/wp-context": "^1.7",
		"maxmind-db/reader": "^1.14"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpstan/phpstan-deprecation-rules": "^1.2",
		"phpstan/phpstan-strict-rules": "^1.6",
		"phpunit/phpunit": "^9.6",
		"slevomat/coding-standard": "^8.14",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "dev-develop",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Primeplaced_Logless_Analytics\\Engine\\": "Engine/",
			"Primeplaced_Logless_Analytics\\Backend\\": "Backend/",
			"Primeplaced_Logless_Analytics\\Services\\": "Services/",
			"Primeplaced_Logless_Analytics\\Rest\\": "Rest/",
			"Primeplaced_Logless_Analytics\\Rest\\Traits\\": "Rest/Traits/",
			"Primeplaced_Logless_Analytics\\Data\\": "Data/",
			"Primeplaced_Logless_Analytics\\Frontend\\": "Frontend/",
			"Primeplaced_Logless_Analytics\\Integrations\\": "Integrations/",
			"Primeplaced_Logless_Analytics\\Internals\\": "Internals/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"phpro/grumphp": true
		},
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true
	},
	"scripts": {
		"phpstan": "vendor/bin/phpstan analyse --debug --memory-limit=1G"
	}
}
