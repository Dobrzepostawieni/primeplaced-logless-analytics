{
	"name": "primeplaced-logless-analytics",
	"version": "1.0.1",
	"description": "Privacy-first, cookieless WordPress analytics with local storage, data minimization, and explicit retention controls.",
	"author": "Dobrzepostawieni <contact@dobrzepostawieni.pl>",
	"license": "GPL-3.0-or-later",
	"keywords": [
		"wordpress",
		"analytics",
		"privacy",
		"cookieless"
	],
	"bugs": {
		"email": "contact@dobrzepostawieni.pl"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.0.0"
	},
	"dependencies": {
		"@freemius/checkout": "^1.4.1",
		"@wordpress/components": "^31.0.0",
		"@wordpress/edit-post": "^8.38.0",
		"@wordpress/element": "^6.37.0",
		"@wordpress/i18n": "^6.10.0",
		"@wordpress/icons": "^11.5.0",
		"@wordpress/plugins": "^7.38.0",
		"@wordpress/ui": "^0.24.0",
		"chart.js": "^4.5.1",
		"chartjs-chart-geo": "^4.3.0",
		"clsx": "^2.1.1",
		"exceljs": "4.4.0",
		"react-chartjs-2": "^5.3.1",
		"topojson-client": "^3.1.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/babel__core": "^7.20.0",
		"@types/jquery": "^3.5.16",
		"@types/jqueryui": "^1.12.16",
		"@types/node": "^25.6.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@types/topojson-client": "^3.1.4",
		"@types/wordpress__block-editor": "^11.5.1",
		"@types/wordpress__blocks": "^12.5.0",
		"@types/wordpress__components": "^23.0.12",
		"@types/wordpress__edit-post": "^8.4.2",
		"@types/wordpress__element": "^2.4.1",
		"@types/wordpress__i18n": "^3.4.0",
		"@wordpress/base-styles": "^6.13.0",
		"@wordpress/block-editor": "^15.10.0",
		"@wordpress/core-data": "^7.37.0",
		"@wordpress/prettier-config": "^4.38.0",
		"@wordpress/scripts": "^24.6.0",
		"@wordpress/stylelint-config": "^23.30.0",
		"ajv": "^8.20.0",
		"copy-webpack-plugin": "^14.0.0",
		"css-declaration-sorter": "^7.4.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-jsdoc": "^48.0.0",
		"identity-obj-proxy": "^3.0.0",
		"postcss-combine-duplicated-selectors": "^10.0.3",
		"postcss-sort-media-queries": "^6.5.0",
		"prettier": "^3.0.0",
		"stylelint": "^16.0.0",
		"typescript": "^5.9.3",
		"world-atlas": "^2.0.2"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"typecheck": "tsc --noEmit --pretty false",
		"lint:js": "wp-scripts lint-js ./assets/src",
		"lint:css": "wp-scripts lint-style './assets/src/**/*.scss'",
		"format": "wp-scripts format"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"eslintConfig": {
		"extends": [
			"plugin:@wordpress/eslint-plugin/recommended",
			"plugin:jsdoc/recommended-typescript"
		],
		"rules": {
			"jsdoc/require-param-type": "off",
			"jsdoc/require-returns-type": "off",
			"jsdoc/require-returns": "off",
			"jsdoc/require-param-description": "off",
			"jsdoc/require-returns-description": "off",
			"jsdoc/newline-after-description": "off",
			"jsdoc/require-param": "off",
			"jsdoc/tag-lines": [
				"warn",
				"any",
				{
					"startLines": 1
				}
			],
			"prettier/prettier": "off"
		},
		"settings": {
			"import/resolver": {
				"typescript": {
					"alwaysTryTypes": true,
					"project": "./tsconfig.json"
				}
			}
		},
		"env": {
			"browser": true,
			"es6": true,
			"jquery": true
		},
		"parser": "@typescript-eslint/parser",
		"globals": {
			"jQuery": true,
			"$": true
		}
	},
	"stylelint": {
		"extends": [
			"@wordpress/stylelint-config",
			"@wordpress/stylelint-config/scss"
		]
	},
	"prettier": "@wordpress/prettier-config"
}
